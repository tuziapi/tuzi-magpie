{
  "name": "@tuzi/magpie-download-page",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite --host 127.0.0.1",
    "metadata": "node scripts/release-metadata.mjs",
    "build": "node scripts/release-metadata.mjs && node scripts/prepare-assets.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "screenshots": "node scripts/capture-product.cjs",
    "format:check": "prettier --check src scripts tests *.js *.json index.html README.md"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "prettier": "3.6.2",
    "vite": "7.2.2"
  }
}
